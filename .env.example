# At least one of ANTHROPIC_API_KEY / HF_TOKEN is required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional free-model fallback via Hugging Face Inference Providers.
# Get a token at https://huggingface.co/settings/tokens (read access is enough).
# HF_TOKEN=hf_...
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

OUTREACH_DB=outreach.db
OUTREACH_ADDR=:8090

# Required for `outreach bot`. Token from @BotFather; allowed IDs from @userinfobot.
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_USERS=123456789
